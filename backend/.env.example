# ==============================================================================
# NETCLONE BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
APP_NAME=NetClone
APP_VERSION=2.0.0
APP_DESCRIPTION=AI-Driven Cyber Twin & Real-Time IoT Defense Framework

# Server Network Settings
HOST=127.0.0.1
PORT=8000
DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# SQLite Database Storage
DATABASE_PATH=netclone.db

# Cryptographic & MLSA Security Settings
SECRET_KEY=netclone_backend_secret_key_demo_change_in_production
MLSA_MASTER_KEY=netclone_mlsa_master_key_secure_2026_demo

# Default User Identities (Seeded upon initial start)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=AdminPassword#2026
OPERATOR_DEFAULT_USERNAME=iot_engineer
OPERATOR_DEFAULT_PASSWORD=SmartSensor$77
