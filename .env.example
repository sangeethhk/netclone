# ==============================================================================
# NETCLONE - COMMERCIAL CODE TEMPLATE CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure the environment variables as needed.
# Do NOT commit .env containing production secrets to public source control.

# ------------------------------------------------------------------------------
# 1. Application Branding & Identity
# ------------------------------------------------------------------------------
APP_NAME=NetClone
APP_VERSION=2.0.0
APP_DESCRIPTION=AI-Driven Cyber Twin & Real-Time IoT Defense Framework
VITE_APP_NAME=NetClone
VITE_APP_TAGLINE=AI-Driven Threat Simulation & Autonomous IoT Defense

# ------------------------------------------------------------------------------
# 2. Server Network & Runtime Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Frontend Client Endpoints
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/telemetry

# ------------------------------------------------------------------------------
# 4. Database & Storage Configuration
# ------------------------------------------------------------------------------
DATABASE_PATH=netclone.db

# ------------------------------------------------------------------------------
# 5. Security Credentials & Cryptographic Keys
# ------------------------------------------------------------------------------
# Cryptographic secret key for token hashing and session signing
# (In production, generate a secure 32+ character random hex or base64 key)
SECRET_KEY=change_this_to_a_secure_random_key_in_production
MLSA_MASTER_KEY=netclone_mlsa_master_key_secure_2026_demo
JWT_SECRET_KEY=netclone_jwt_super_secret_key_change_in_production

# Initial Administrative & Field Operator Identity Seeds
# Used only during initial database bootstrap if accounts do not exist
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=AdminPassword#2026
OPERATOR_DEFAULT_USERNAME=iot_engineer
OPERATOR_DEFAULT_PASSWORD=SmartSensor$77

# ------------------------------------------------------------------------------
# 6. Optional Third-Party Service Placeholders
# ------------------------------------------------------------------------------
# Plug in optional third-party integrations here if extending the template:
# TMDB_API_KEY=your_tmdb_api_key_placeholder
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_placeholder
# STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_placeholder
# FIREBASE_API_KEY=your_firebase_api_key_placeholder
# FIREBASE_PROJECT_ID=your_firebase_project_id_placeholder
